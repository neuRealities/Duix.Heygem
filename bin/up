#!/bin/bash
echo "Starting Duix.HeyGem containers in detached mode..."
cd "deploy"
docker compose -f docker-compose-linux.yml up -d
cd ..

echo "Opening WebUI Gradio Interface..."
URL="http://127.0.0.1:7860/"
xdg-open $URL > /dev/null 2>&1 || sensible-browser $URL || x-www-browser $URL || gnome-open $URL || explorer.exe $URL
# Open up browsers
echo "Opening Watchdog App..."
URL="http://127.0.0.1:5000/"
xdg-open $URL > /dev/null 2>&1 || sensible-browser $URL || x-www-browser $URL || gnome-open $URL || explorer.exe $URL

echo "Running WebUI and Watchdog..."
# Run two apps side-by-side since they both output to console
python watchdog/watchdog_app.py & python app.py --lang en
